{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet test *)",
      "Bash(dotnet build *)",
      "Bash(dotnet restore *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet restore *)",

      "Bash(pwsh -NoProfile -File tools/godot.ps1 *)",
      "Bash(pwsh -NoProfile -File tools/blender.ps1 *)",
      "PowerShell(pwsh -NoProfile -File tools/godot.ps1 *)",
      "PowerShell(pwsh -NoProfile -File tools/blender.ps1 *)",
      "PowerShell(./tools/godot.ps1 *)",
      "PowerShell(./tools/blender.ps1 *)",
      "Bash(python pipeline/comfy_gen.py *)",
      "PowerShell(python pipeline/comfy_gen.py *)",
      "Bash(python pipeline/image_tools.py *)",
      "PowerShell(python pipeline/image_tools.py *)",

      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git ls-files *)", "Bash(git rev-parse *)",
      "Bash(git hash-object *)", "Bash(git check-ignore *)", "Bash(git blame *)",
      "Bash(git branch)", "Bash(git branch --show-current)", "Bash(git branch -a)",
      "Bash(git stash list *)", "Bash(git stash show *)", "Bash(git stash push *)",
      "Bash(git fetch *)", "Bash(git remote -v)",
      "PowerShell(git status *)", "PowerShell(git diff *)", "PowerShell(git log *)", "PowerShell(git show *)",
      "PowerShell(git add *)", "PowerShell(git commit *)", "PowerShell(git ls-files *)", "PowerShell(git rev-parse *)",
      "PowerShell(git hash-object *)", "PowerShell(git check-ignore *)", "PowerShell(git blame *)",
      "PowerShell(git branch)", "PowerShell(git branch --show-current)", "PowerShell(git branch -a)",
      "PowerShell(git stash list *)", "PowerShell(git stash show *)", "PowerShell(git stash push *)",
      "PowerShell(git fetch *)", "PowerShell(git remote -v)"
    ],
    "ask": [
      "Bash(git push)", "Bash(git push *)",
      "PowerShell(git push)", "PowerShell(git push *)",

      "Bash(rm *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(rmdir *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-stop.ps1\"",
            "timeout": 300,
            "statusMessage": "Running Core tests..."
          }
        ]
      }
    ]
  }
}
