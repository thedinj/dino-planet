// Asset registry: the contract between the asset pipeline and the game.
// Positions are meters in the asset's own space: Y up, the asset faces -Z (forward).
// "model" may point at a file that doesn't exist yet; the game shows a placeholder shape.
// Toggle socket markers in-game with F3 to check placement.
{
  "assets": [
    {
      "id": "velociraptor",
      "kind": "dino",
      "model": "res://models/velociraptor.glb",
      "scale": 1.0,
      "modelYawDegrees": 0,
      "collider": { "radius": 0.6, "height": 1.4 },
      "sockets": {
        "saddle": { "position": [0, 1.15, 0.15] },
        "turret": { "position": [0, 1.3, 0.55] }
      }
    },
    {
      "id": "trex",
      "kind": "dino",
      "model": "res://models/trex.glb",
      "scale": 1.0,
      "tint": "#C9A27A",
      "collider": { "radius": 1.3, "height": 3.2 },
      "sockets": {
        "saddle": { "position": [0, 2.55, 0.4] },
        "turret_left": { "position": [-0.9, 2.1, 0.1], "yawDegrees": 35 },
        "turret_right": { "position": [0.9, 2.1, 0.1], "yawDegrees": -35 }
      }
    },
    {
      "id": "laser_cannon",
      "kind": "weapon",
      "model": "res://models/laser_cannon.glb",
      "collider": { "radius": 0.2, "height": 0.3 },
      "sockets": {
        "muzzle": { "position": [0, 0.12, -0.6] }
      }
    },
    {
      "id": "rider",
      "kind": "rider",
      "model": "res://models/rider.glb",
      "collider": { "radius": 0.25, "height": 0.9 }
    },
    {
      "id": "laser_bolt",
      "kind": "projectile",
      "model": "",
      "tint": "#FF5A3C",
      "collider": { "radius": 0.1, "height": 0.1 }
    },
    {
      "id": "tree",
      "kind": "prop",
      "model": "res://models/tree.glb",
      "collider": { "radius": 0.5, "height": 4.0 }
    },
    {
      "id": "rock",
      "kind": "prop",
      "model": "res://models/rock.glb",
      "collider": { "radius": 0.9, "height": 0.9 }
    }
  ]
}
